{
  "name": "owasp-assessment-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data": "python3 ../scripts/build_dashboard_data.py || python ../scripts/build_dashboard_data.py",
    "fixture": "python3 dev/make_fixture.py || python dev/make_fixture.py",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "codemap": "node ../scripts/codebase-map.mjs --root .. --out public/codebase/index.html --title \"OWASP Assessment Lab \u2014 codebase\""
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "dompurify": "^3.4.16",
    "lucide-react": "^1.48.0",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
